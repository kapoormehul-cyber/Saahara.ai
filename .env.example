# SAAHARA AI Environment Variables — AZINHACK '26
# Backend Server Port
PORT=3001

# TinyFish AI Configuration
# Get your API key from https://agent.tinyfish.ai/api-keys or TinyFish Developer Hub
# When omitted, SAAHARA AI runs seamlessly in labelled demo adapter mode with authoritative pre-verified records.
TINYFISH_API_KEY=
TINYFISH_API_URL=https://api.search.tinyfish.ai
